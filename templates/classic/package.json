    "prettier": "^3.6.2",
    "turbo": "^2.8.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.37.0",
    "unocss": "^66.5.0",
    "unplugin-auto-import": "^20.0.0",
